# ==============================================================================
# Sustain Republix (SRG-Website) - Environment Variables Template
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env.local หรือ .env ในเครื่องของคุณ:
# cp .env.example .env.local
#
# ค่าเหล่านี้สามารถดูได้จาก Sanity Manage Dashboard (https://www.sanity.io/manage)
# ==============================================================================

# Sanity Project ID (จำเป็น)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here

# Sanity Dataset Name (ค่าเริ่มต้นคือ production)
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Version (วันที่เวอร์ชัน API เช่น 2026-03-27)
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-27
